{
  "name": "board-daddy",
  "productName": "Board Daddy",
  "version": "1.0.0",
  "description": "Export any online storyboard or treatment to full-resolution PDF, PNG, or text.",
  "main": "main.js",
  "author": "Christian Nielsen",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "test:smoke": "electron test/smoke.js --no-sandbox",
    "test:yt": "electron test/yt-smoke.js",
    "test:frames": "electron test/frames-smoke.js",
    "test:e2e": "electron test/e2e.js",
    "test:pitch": "electron test/pitch-smoke.js",
    "dist:installer": "bash installer/build-installer-dmg.sh",
    "test:all": "npm run test:smoke && npm run test:yt && npm run test:frames && npm run test:pitch && npm run test:e2e"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.boarddaddy.app",
    "productName": "Board Daddy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "Board-Daddy-${version}-${arch}.dmg"
    },
    "dmg": {
      "title": "Board Daddy",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
